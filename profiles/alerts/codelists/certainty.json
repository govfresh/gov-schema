{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@id": "https://schema.govfresh.com/v1/Certainty",
  "@type": "DefinedTermSet",
  "name": "Certainty",
  "description": "Confidence that the event will occur or has occurred, from OASIS CAP 1.2. Published alongside severity so that a low-confidence extreme warning is distinguishable from an observed one.",
  "url": "http://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2-os.html",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/observed",
      "termCode": "observed",
      "name": "Observed",
      "description": "Determined to have occurred or to be ongoing."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/likely",
      "termCode": "likely",
      "name": "Likely",
      "description": "Probability greater than about 50%."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/possible",
      "termCode": "possible",
      "name": "Possible",
      "description": "Possible but not likely."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/unlikely",
      "termCode": "unlikely",
      "name": "Unlikely",
      "description": "Not expected to occur."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/unknown",
      "termCode": "unknown",
      "name": "Unknown",
      "description": "Certainty not known."
    }
  ]
}
