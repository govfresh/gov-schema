{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@id": "https://schema.govfresh.com/v1/AwardStatus",
  "@type": "DefinedTermSet",
  "name": "Award status",
  "description": "The state of a decision to award a contract, from OCDS.",
  "url": "https://standard.open-contracting.org",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "gs:awardstatus/pending",
      "termCode": "pending",
      "name": "Pending",
      "description": "Decided but not yet in force."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:awardstatus/active",
      "termCode": "active",
      "name": "Active",
      "description": "In force."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:awardstatus/cancelled",
      "termCode": "cancelled",
      "name": "Cancelled",
      "description": "Withdrawn after being made."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:awardstatus/unsuccessful",
      "termCode": "unsuccessful",
      "name": "Unsuccessful",
      "description": "A bid that was not awarded. Publishing these, not only the winner, is what makes a competition auditable."
    }
  ]
}
