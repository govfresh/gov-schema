    },
    {
      "@id": "https://www.gov.uk/id/service/book-driving-test",
      "@type": "GovernmentService",
      "name": "Book your driving test",
      "description": "Book your official DVSA practical driving test for cars from £62, or other types of practical driving tests, including motorcycle and driving instructor tests.\r\n",
      "url": "https://www.gov.uk/book-driving-test",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/book-driving-test"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/d39237a5-678b-4bb5-a372-eb2cb036933d",
        "name": "Driver and Vehicle Standards Agency"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "vehicle"
      ],
      "keywords": [
        "Car driving tests",
        "Driving, motorcycle and LGV instructor qualification process",
        "Lorry, bus, coach and specialist vehicle driving tests",
        "Motorcycle and moped tests",
        "Driving tests and learning to drive or ride",
        "HGV, bus and coach drivers"
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-02",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://driverpracticaltest.dvsa.gov.uk/application",
          "name": "Continues on  the driving test booking service"
        }
      ],
      "applicationProcess": "Book your practical driving test for: cars motorcycles lorries, buses and coaches approved driving instructor ( ADI ) part 2 and 3 tests This page is also available in Welsh (Cymraeg) . Who can book a car driving test You must book your driving test yourself. If you need to change, swap or cancel it, you’ll also need to do this yourself. Your driving instructor is not allowed to do this for you. It’s against the law to book a car driving test for someone else. Book a test online You’ll be put in a queue when you start booking your driving test - you’ll be told how long you’ll need to wait once you begin. New driving test appointments are added 24 weeks in advance. These appointments are released at 6am every Monday. If you need a test sooner, earlier driving tests (sometimes called ‘cancellation appointments’) are added whenever another learner changes or cancels their test. This can be at any time during the week. There is no waiting list or cancellation list. This service is availabl"
    },
    {
      "@id": "https://www.gov.uk/id/service/view-driving-licence",
      "@type": "GovernmentService",
      "name": "View or share your driving licence information",
      "description": "Find out what information DVLA holds about your driving licence or create a check code to share your driving record, for example to hire a car ",
      "url": "https://www.gov.uk/view-driving-licence",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/view-driving-licence"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/70580624-93b5-4aed-823b-76042486c769",
        "name": "Driver and Vehicle Licensing Agency"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "vehicle"
      ],
      "keywords": [
        "Personal driving licence information",
        "Driving in the UK and abroad",
        "Driving licences",
        "Driving tests and learning to drive or ride"
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-02",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://www.viewdrivingrecord.service.gov.uk/driving-record/licence-number"
        }
      ],
      "applicationProcess": "You can view or share your driving licence information if your licence was issued in England, Wales or Scotland. It’s a criminal offence to obtain someone else’s personal information without their permission. Use this service to: view your driving record, for example vehicles you can drive check your penalty points or disqualifications create a licence ‘check code’ to share your driving record with someone, for example a car hire company The check code will be valid for 21 days. Before you start You’ll need: your driving licence number your National Insurance number - find your National Insurance number if you’ve lost it the postcode on your driving licence This service is also available in Welsh (Cymraeg) ."
    },
    {
