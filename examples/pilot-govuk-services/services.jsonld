      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://check-your-travel-permission.homeoffice.gov.uk"
        }
      ],
      "applicationProcess": "Use this service to check: if you have an electronic travel authorisation (ETA) to visit the UK when your ETA expires An ETA lasts for 2 years and is linked to your passport. If your passport has expired or changed, you’ll need to apply for a new ETA . Check your ETA online You’ll need the passport you used when you applied for your ETA."
    },
    {
      "@id": "https://www.gov.uk/id/service/find-energy-certificate",
      "@type": "GovernmentService",
      "name": "Find an energy certificate",
      "description": "Find a property's energy certificate including an energy performance certificate (EPC), display energy certificate (DEC) or air conditioning inspection certificate. ",
      "url": "https://www.gov.uk/find-energy-certificate",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/find-energy-certificate"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/1390d07f-12b3-4f55-9dd5-fec5fd9e3649",
        "name": "Ministry of Housing, Communities and Local Government"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "housing",
        "environment"
      ],
      "keywords": [
        "Being a landlord and renting out a room",
        "Household energy",
        "Planning permission and building regulations "
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-02",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://find-energy-certificate.service.gov.uk/find-a-certificate/type-of-property"
        }
      ],
      "applicationProcess": "Find an energy certificate for a property in England, Wales or Northern Ireland. This includes homes, business properties and public buildings. This service is also available in Welsh (Cymraeg) . There’s a different service to find an energy certificate for properties in Scotland . You can use this service to find an existing: energy performance certificate (EPC) display energy certificate (DEC) for a public building air conditioning inspection certificate and report If your property does not have an energy certificate or it has expired, you can get a new energy certificate . You can search for a certificate by postcode, street name and town, or certificate number."
    },
    {
