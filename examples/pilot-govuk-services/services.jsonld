{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@graph": [
    {
      "@id": "https://www.gov.uk/id/service/sign-in-universal-credit",
      "@type": "GovernmentService",
      "name": "Sign in to your Universal Credit account",
      "description": "Sign in to your Universal Credit account - report a change, add a note to your journal, see your payments and do other tasks ",
      "url": "https://www.gov.uk/sign-in-universal-credit",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/sign-in-universal-credit"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/b548a09f-8b35-4104-89f4-f1a40bf3136d",
        "name": "Department for Work and Pensions"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "benefits"
      ],
      "keywords": [
        "Benefits entitlement",
        "Universal Credit",
        "Manage an existing benefit, payment or claim"
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-04",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://www.universal-credit.service.gov.uk/sign-in"
        }
      ],
      "applicationProcess": "Sign in to your Universal Credit account to: apply for an advance on your first payment see your statement report a change in circumstances see when your next payment will be see your claimant commitment check your to-do list (for example, if your work coach has booked an appointment with you) send messages to your case manager or work coach using your journal It might take a few days for your case manager or work coach to reply. You’ll usually get a text or email if your journal or to-do list is updated. Use the username and password you set up when you applied for Universal Credit. You can ask for a reminder if you’re not sure. This service is also available in Welsh (Cymraeg) ."
    },
    {
      "@id": "https://www.gov.uk/id/service/check-mot-history",
      "@type": "GovernmentService",
      "name": "Check the MOT history of a vehicle",
      "description": "Check the MOT history of a vehicle from 2005 onwards, including if it passed or failed, its mileage and why it failed, download MOT test certificate",
      "url": "https://www.gov.uk/check-mot-history",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/check-mot-history"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/d39237a5-678b-4bb5-a372-eb2cb036933d",
        "name": "Driver and Vehicle Standards Agency"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "vehicle",
        "tax"
      ],
      "keywords": [
        "Buying, selling, registering and scrapping a vehicle",
        "Driver and vehicle record",
        "Car, motorcycle and van MOT tests",
        "HGV, bus and trailer MOT tests",
        "Vehicle and driver data and information",
        "Vehicle tax, MOT and insurance"
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-02",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://www.check-mot.service.gov.uk/"
        }
      ],
      "applicationProcess": "Check the past results of a vehicle’s MOT tests, including: if it passed or failed the mileage recorded when it was tested You can also: check when the next MOT is due download a copy of the current and previous MOT certificates If you got your test in England, Scotland or Wales You’ll also be able to see: where each test was done - you’ll need the 11-digit number from the vehicle’s log book (V5C) what parts failed at each test, and if any parts had minor problems Your MOT history may also tell you if your vehicle has been recalled for a safety reason, depending on the manufacturer. You can also check if a vehicle model, part or accessory has been recalled . Which test results you can get For cars, motorcycles and vans you can only get results for tests done since 2005. For HGVs, trailers, buses and coaches you can only get results for tests done since 2018. If you got your test in Northern Ireland You can only get results for tests done since 2017. Check a vehicle’s MOT history You’ll"
    },
    {
      "@id": "https://www.gov.uk/id/service/vehicle-tax",
      "@type": "GovernmentService",
      "name": "Tax your vehicle",
      "description": "Renew or tax your vehicle for the first time using a reminder letter, your log book or the green 'new keeper' slip - and how to tax if you do not have any documents",
      "url": "https://www.gov.uk/vehicle-tax",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:govuk-path",
          "value": "/vehicle-tax"
        }
      ],
      "provider": {
        "@id": "https://www.gov.uk/id/organization/70580624-93b5-4aed-823b-76042486c769",
        "name": "Driver and Vehicle Licensing Agency"
      },
      "areaServed": {
        "@id": "https://www.gov.uk/id/jurisdiction/gb",
        "name": "United Kingdom"
      },
      "serviceStatus": "active",
      "lifeEvent": [
        "vehicle",
        "tax"
      ],
      "keywords": [
        "Vehicle tax",
        "Vehicle tax, MOT and insurance"
      ],
      "availableLanguage": [
        "en-GB"
      ],
      "dateModified": "2026-09-02",
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://vehicletax.service.gov.uk/"
        }
      ],
      "applicationProcess": "Use this service to tax your car, motorcycle or other vehicle using a reference number from: a recent vehicle tax reminder or ‘last chance’ warning letter from DVLA your vehicle log book (V5C) - it must be in your name the green ‘new keeper’ slip from a log book if you’ve just bought it If you do not have any of these documents, you’ll need to apply for a new log book . You can tax your vehicle at the same time. You can pay vehicle tax by Direct Debit , or debit or credit card. You must tax your vehicle even if you do not have to pay anything because it’s exempt from vehicle tax . You’ll need to meet all the legal obligations for drivers before you can drive. This service is also available in Welsh (Cymraeg) ."
    },
    {
