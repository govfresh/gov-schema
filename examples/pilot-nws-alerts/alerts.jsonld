      "alertInfo": [
        {
          "@type": "AlertInfo",
          "inLanguage": "en-US",
          "category": [
            "met"
          ],
          "event": "Special Marine Warning",
          "urgency": "immediate",
          "severity": "severe",
          "certainty": "likely",
          "expires": "2026-09-07T03:00:00-04:00",
          "headline": "Special Marine Warning issued September 7 at 12:59AM EDT until September 7 at 3:00AM EDT by NWS Tallahassee FL",
          "description": "SMWTAE\n\nThe National Weather Service in Tallahassee has issued a\n\n* Special Marine Warning for...\nCoastal Waters From  Ochlockonee River to Apalachicola FL out to 20\nNm...\nCoastal Waters from Mexico Beach to Apalachicola out 20 NM...\n\n* Until 300 AM EDT/200 AM CDT/.\n\n* At 1259 AM EDT/1159 PM CDT/, strong thunderstorms were located\nalong a line extending from 15 nm southwest of St. Marks to near\nBuckeye Reef, moving southwest at 30 knots.\n\nHAZARD...Wind gusts 34 knots or greater.\n\nSOURCE...Radar indicated.\n\nIMPACT...Expect wind gusts in excess of 34 knots...suddenly higher\nwaves...frequent lightning...and heavy downpours. Make\nsure all on board are wearing life jackets.\n\n* Locations impacted include...\nO Tower, Apalachicola, C Tower, St George Island, and K Tower.",
          "instruction": "Move to safe harbor until hazardous weather passes.",
          "effective": "2026-09-07T00:59:00-04:00",
          "onset": "2026-09-07T00:59:00-04:00",
          "senderName": "NWS Tallahassee FL",
          "responseType": [
            "avoid"
          ],
          "web": "http://www.weather.gov"
        }
      ],
