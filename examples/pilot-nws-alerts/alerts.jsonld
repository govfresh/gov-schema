      "scope": "public",
      "alertInfo": [
        {
          "@type": "AlertInfo",
          "inLanguage": "en-US",
          "category": [
            "met"
          ],
          "event": "Severe Thunderstorm Warning",
          "urgency": "immediate",
          "severity": "severe",
          "certainty": "observed",
          "expires": "2026-09-07T00:30:00-06:00",
          "headline": "Severe Thunderstorm Warning issued September 6 at 11:25PM MDT until September 7 at 12:30AM MDT by NWS Glasgow MT",
          "description": "SVRGGW\n\nThe National Weather Service in Glasgow has issued a\n\n* Severe Thunderstorm Warning for...\nWestern Phillips County in northeastern Montana...\n\n* Until 1230 AM MDT.\n\n* At 1125 PM MDT, a severe thunderstorm was located 11 miles\nsouthwest of Dodson, or 24 miles west of Malta, moving northeast at\n25 mph.\n\nHAZARD...Golf ball size hail.\n\nSOURCE...Radar indicated.\n\nIMPACT...People and animals outdoors will be injured. Expect\ndamage to roofs, siding, windows, and vehicles.\n\n* Locations impacted include...\nDodson and Wagner.",
          "instruction": "For your protection move to an interior room on the lowest floor of a\nbuilding.\n\nLarge hail, damaging wind, and continuous cloud to ground lightning\nare occurring with this storm. Move indoors immediately. Lightning is\none of nature's leading killers. Remember, if you can hear thunder,\nyou are close enough to be struck by lightning.\n\nTorrential rainfall is occurring with this storm, and may lead to\nflash flooding. Do not drive your vehicle through flooded roadways.",
          "effective": "2026-09-06T23:25:00-06:00",
          "onset": "2026-09-06T23:25:00-06:00",
          "senderName": "NWS Glasgow MT",
          "responseType": [
            "shelter"
          ],
          "web": "http://www.weather.gov"
        }
      ],
      "area": [
        {
