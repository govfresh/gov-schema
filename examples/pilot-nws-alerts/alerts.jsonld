          ],
          "event": "Severe Thunderstorm Warning",
          "urgency": "immediate",
          "severity": "severe",
          "certainty": "observed",
          "expires": "2026-09-06T23:30:00-06:00",
          "headline": "Severe Thunderstorm Warning issued September 6 at 11:00PM MDT until September 6 at 11:30PM MDT by NWS Great Falls MT",
          "description": "At 1100 PM MDT, a severe thunderstorm was located over Roy, or 29\nmiles northeast of Lewistown, moving northeast at 25 mph.\n\nHAZARD...Quarter size hail.\n\nSOURCE...Radar indicated.\n\nIMPACT...Damage to vehicles is expected.\n\nLocations impacted include...\nRoy.",
          "instruction": "For your protection move to an interior room on the lowest floor of a\nbuilding.\n\nTorrential rainfall is occurring with this storm, and may lead to\nflash flooding. Do not drive your vehicle through flooded roadways.",
          "effective": "2026-09-06T23:00:00-06:00",
          "onset": "2026-09-06T23:00:00-06:00",
          "senderName": "NWS Great Falls MT",
          "responseType": [
            "shelter"
          ],
          "web": "http://www.weather.gov"
        }
