          ],
          "event": "Special Weather Statement",
          "urgency": "expected",
          "severity": "moderate",
          "certainty": "observed",
          "expires": "2026-09-07T00:00:00-06:00",
          "headline": "Special Weather Statement issued September 6 at 11:15PM MDT by NWS Cheyenne WY",
          "description": "At 1114 PM MDT, Doppler radar was tracking a cluster of strong\nthunderstorms over Harrison, or 30 miles east of Lusk, moving\nnortheast at 45 mph.\n\nHAZARD...Wind gusts up to 50 mph and half inch hail.\n\nSOURCE...Radar indicated.\n\nIMPACT...Gusty winds could knock down tree limbs and blow around\nunsecured objects. Minor hail damage to vegetation is\npossible.\n\nLocations impacted include...\nHarrison and Montrose.",
          "instruction": "If outdoors, consider seeking shelter inside a building.\n\nTorrential rainfall is also occurring with this storm and may lead to\nlocalized flooding. Do not drive your vehicle through flooded\nroadways.",
          "effective": "2026-09-06T23:15:00-06:00",
          "onset": "2026-09-06T23:15:00-06:00",
          "senderName": "NWS Cheyenne WY",
          "responseType": [
            "execute"
          ],
          "web": "http://www.weather.gov"
        }
      ],
