    {
      "@id": "https://api.weather.gov/id/alert/urn-oid-2-49-0-1-840-0-6e4d20aacd5c0543c1b063e3a2b69244a354af1d-001-1",
      "@type": "Alert",
      "alertIdentifier": "urn:oid:2.49.0.1.840.0.6e4d20aacd5c0543c1b063e3a2b69244a354af1d.001.1",
