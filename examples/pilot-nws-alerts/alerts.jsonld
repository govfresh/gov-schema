      "alertInfo": [
        {
          "@type": "AlertInfo",
          "inLanguage": "en-US",
          "category": [
            "met"
          ],
          "event": "Special Weather Statement",
          "urgency": "expected",
          "severity": "moderate",
          "certainty": "observed",
          "expires": "2026-09-07T00:00:00-06:00",
          "headline": "Special Weather Statement issued September 6 at 11:25PM MDT by NWS Cheyenne WY",
          "description": "At 1125 PM MDT, Doppler radar was tracking a cluster of strong\nthunderstorms 7 miles southwest of Warren AFB, or 10 miles southwest\nof Cheyenne, moving northeast at 25 mph.\n\nHAZARD...Wind gusts up to 50 mph and pea size hail.\n\nSOURCE...Radar indicated.\n\nIMPACT...Gusty winds could knock down tree limbs and blow around\nunsecured objects. Minor hail damage to vegetation is\npossible.\n\nLocations impacted include...\nCheyenne, Happy Valley, Rocking Star Ranch, Silver Sage Estates, Fox\nFarm-College, Cheyenne Regional Airport, Winchester Hills, South\nGreeley Highway, Ranchettes, Warren AFB, Frontier Park, North\nCheyenne, South Cheyenne, Bison Crossing, and Cowboy Ranch South.",
          "instruction": "If outdoors, consider seeking shelter inside a building.\n\nTorrential rainfall is also occurring with this storm and may lead to\nlocalized flooding. Do not drive your vehicle through flooded\nroadways.",
          "effective": "2026-09-06T23:25:00-06:00",
          "onset": "2026-09-06T23:25:00-06:00",
          "senderName": "NWS Cheyenne WY",
          "responseType": [
            "execute"
          ],
          "web": "http://www.weather.gov"
        }
      ],
