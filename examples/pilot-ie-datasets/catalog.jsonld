      "license": "https://creativecommons.org/licenses/by/4.0/",
      "inLanguage": [
        "en"
      ],
      "distribution": [
        {
          "@type": "DataDownload",
          "name": "2026 Q2 FOI Disclosure Log - Department of Culture, Communications and Sport ",
          "contentUrl": "https://assets.gov.ie/static/documents/a4e85f97/20260818-FOI-Disclosure-Log-Q2-2026-CSV_1.csv",
          "encodingFormat": "text/csv",
          "dateModified": "2026-08-27T08:27:53"
        }
      ],
      "description": "Freedom of Information cases from April 2026 to June 2026. These logs provide the following information in relation to each request received: the reference Number assigned to the request by the department the date on which the request was received in the Freedom of Information Unit of the department the category of the person making the request, for example: whether they are a journalist, interest group or company or an individual. This includes non-personal FOI requests only a summary of the information or records requested the date on which the department’s decision was issued to the applicant a summary of that decision, for example; whether the request was granted in full, part granted or refused. All records released in relation to requests as set out in the FOI logs are deemed by the Department to be in the public domain and are available to anyone on request. For access to these records, please contact the Department’s FOI Unit at foi@ccs.gov.ie with the Request Number and details of the specific records being sought. Records will be provided outside of the FOI process for such requests.",
      "temporalCoverage": "2026-04-01/2026-06-30",
      "applicableLegislation": [
        "https://www.irishstatutebook.ie/eli/2014/act/30/enacted/en/html"
      ],
      "highValueDataset": false
    },
