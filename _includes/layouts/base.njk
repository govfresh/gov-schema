<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="stylesheet" href="/assets/lf-ui/bootstrap.min.css">
<link rel="stylesheet" href="/assets/lf-ui/lf-theme.css">
<link rel="stylesheet" href="/assets/lf-ui/lf-components.css">
<style>
  .gs-mono { font-family: "Roboto Mono", ui-monospace, monospace; }
  .gs-field-table code { font-size: .8125rem; word-break: break-word; }
  .gs-req { font-size: .6875rem; letter-spacing: .04em; text-transform: uppercase; }
  .gs-sidebar { position: sticky; top: 1.5rem; }
  .gs-hero { border-bottom: 1px solid var(--bs-border-color); }
  pre[class*="language-"], pre { max-height: 32rem; overflow: auto; }
  .gs-ns { word-break: break-all; }
</style>
</head>
<body class="d-flex flex-column min-vh-100">
<a href="#main" class="visually-hidden-focusable skip-link">Skip to main content</a>
{% include "nav.njk" %}
<main id="main" class="flex-grow-1">
  {{ content | safe }}
</main>
{% include "footer.njk" %}
<script src="/assets/lf-ui/bootstrap.bundle.min.js"></script>
</body>
</html>
